# Optional. Service account key for agents. Leave blank to use your own
# login (gcloud auth login --update-adc).
GOOGLE_APPLICATION_CREDENTIALS=

# Optional. Default for --project.
GCP_DEFAULT_PROJECT=

# Optional. With your own login, project billed for quota on calls not tied
# to one project (listing projects). Any project you own with the APIs on.
GCP_QUOTA_PROJECT=
